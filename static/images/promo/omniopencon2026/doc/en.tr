.fp 1 R Lato-Regular ttf
.fp 2 I Lato-Italic ttf
.fp 3 B Lato-Bold ttf
.fp 4 BI Lato-BoldItalic ttf
.fp 5 L Lato-Light ttf
.fp 6 LI Lato-LightItalic ttf
.do xflag 3
.mediasize a5
.de HR
.	ps 12p
.	sp 0.5c
\l´11.2c´
.	sp 0.5c
.	ps
..
.de US
.	ft 2
\\$1\l´|0\(ul´
.	ft
..
.de CS
.	br
.	mk T        \" top of columns
.	nr cn 0 1   \" column number
.	nr M \\n(.o \" save left margin
.	nr L \\n(.l \" save line length
.	nr B \\nT   \" bottom of columns
..
.de CL
.	nrf l (\\$1*\\nL)
.	if \\n+(cn>1                 \{\
.		if \\n(nl>\\nB .mk B      \" save bottom position
.		br                        \" force end of paragraph
.		po +\\npu                 \" increase page offset
.		sp |\\nTu            \}\  \" return to top of columns
.	ll \\nlu                          \" shorten line length
.	ll -0.5c
.	nr p \\nl                         \" previous l value + margin
.	nr p +0.5c
..
.de CE
.	sp |\\nBu
.	po \\nMu
.	ll \\nLu
..
.CS
